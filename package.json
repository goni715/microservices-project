{
  "name": "microservices-chat-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter \"./services/*\" --parallel dev",
    "dev:auth": "pnpm --filter auth-service dev",
    "dev:user": "pnpm --filter user-service dev",
    "dev:gateway": "pnpm --filter gateway-service dev",
    "build": "pnpm -r build",
    "build:common": "pnpm --filter @chatapp/common build",
    "build:auth": "pnpm --filter auth-service build",
    "build:user": "pnpm --filter user-service build",
    "build:gateway": "pnpm --filter gateway-service build",
    "start:auth": "pnpm --filter auth-service start",
    "start:user": "pnpm --filter user-service start",
    "start:gateway": "pnpm --filter gateway-service start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}